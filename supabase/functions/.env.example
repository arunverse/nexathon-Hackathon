# Local Edge Function env (used with: supabase functions serve gemini --env-file supabase/functions/.env)
# In PRODUCTION these are set via `supabase secrets set ...` — never committed.
GEMINI_API_KEY=your-gemini-key-here
# Comma-separated allowlist for CORS (S5). Defaults to localhost + ebexta.com if unset.
ALLOWED_ORIGINS=http://localhost:4000,https://ebexta.com
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime for deployed functions; for local serve, add them here too.
